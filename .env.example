# ==========================================
# MOTOASSIST — ENVIRONMENT VARIABLES TEMPLATE
# ==========================================
# Copy this file to .env or .env.local for local development.
# NEVER commit real production secrets to version control.

# ------------------------------------------
# BACKEND CONFIGURATION (Render / Node.js)
# ------------------------------------------
NODE_ENV=production
PORT=5000

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/motoassist?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/motoassist?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_strong_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (CORS & Socket.IO)
CLIENT_URL=https://motoassist.in
SOCKET_CORS_ORIGIN=https://motoassist.in

# Optional External Emergency Gateways (Twilio / MSG91)
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=

# ------------------------------------------
# FRONTEND CONFIGURATION (Vercel / Vite PWA)
# ------------------------------------------
# Live API Base URL (Must NOT include trailing slash)
# Production: https://api.motoassist.in
# Local Dev: http://localhost:5000
VITE_API_URL=https://api.motoassist.in

# Google Maps / Places API Key (Must be restricted by HTTP referrer in Google Cloud Console)
VITE_GOOGLE_MAPS_API_KEY=
